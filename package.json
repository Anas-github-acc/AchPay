{
  "name": "agent-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/http/server.ts",
    "dev:all": "./scripts/dev-all.sh",
    "ngrok": "ngrok http 3000 --url https://unpaced-dan-semioptimistically.ngrok-free.dev",
    "start": "tsx apps/api/src/http/server.ts",
    "dev:web": "pnpm --filter @storefront/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --root apps/api",
    "test:watch": "vitest --root apps/api",
    "test:adversarial": "vitest run --root apps/api tests/adversarial",
    "verify:ledger": "tsx apps/api/scripts/verify-ledger.ts",
    "reclaim": "tsx apps/api/scripts/reclaim.ts",
    "demo:provision": "tsx apps/api/scripts/provision-demo-user.ts",
    "smoke:razorpay": "tsx apps/api/scripts/razorpay-smoke.ts",
    "test:webhook-live": "tsx apps/api/scripts/webhook-live-test.ts",
    "test:autopay": "tsx apps/api/scripts/autopay-test.ts",
    "mcp": "tsx apps/api/src/mcp/server.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node_modules/.bin/tsx apps/api/src/mcp/server.ts",
    "mcp:add": "claude mcp add agent-storefront -- ./node_modules/.bin/tsx ./apps/api/src/mcp/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "supabase": "^2.117.0",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
