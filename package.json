{
  "name": "agent-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/http/server.ts",
    "start": "tsx src/http/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:adversarial": "vitest run tests/adversarial",
    "verify:ledger": "tsx scripts/verify-ledger.ts",
    "smoke:razorpay": "tsx scripts/razorpay-smoke.ts",
    "test:webhook-live": "tsx scripts/webhook-live-test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.9.0",
    "pg": "^8.16.3",
    "razorpay": "^2.9.8",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
