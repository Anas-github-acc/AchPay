# Razorpay test-mode credentials (Phase 5+). Never commit the real .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Dashboard -> Settings -> Webhooks, on the endpoint itself. The webhook
# route refuses to run without it rather than accepting unverified events.
RAZORPAY_WEBHOOK_SECRET=

# Any long random string. Signs quotes; rotating it invalidates outstanding quotes.
QUOTE_SIGNING_SECRET=dev_only_change_me_00000000000000000000000000000000

# Ports match docker-compose.yml (deliberately non-default).
DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront
REDIS_URL=redis://localhost:56379

PORT=3000
NODE_ENV=development

# The origin approval links are built with. Not taken from the request Host
# header — that is caller-supplied. For a phone demo, set this to your ngrok
# URL so the link in the agent's reply actually opens.
PUBLIC_BASE_URL=http://localhost:3000

# How long a human has to approve a gated purchase before the token dies.
APPROVAL_TTL_SECONDS=900

# Integration tests run against their own database on the same instance.
TEST_DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront_test

# Which payment rail moves the money. One of:
#   fake | flaky-fake | always-failing | razorpay | reserve-pay
# Switching to real test-mode payments is this value plus a restart.
PAYMENT_ADAPTER=fake

# Debit cadence declared on the mandate token. `as_presented` is the one that
# fits an agent storefront: amounts and timing follow the user, not a schedule.
RAZORPAY_MANDATE_FREQUENCY=as_presented

# Sends token.type = single_block_multiple_debit on mandate orders. Needs UPI
# Reserve Pay activation on the account; leave false until Razorpay enables it.
RAZORPAY_SBMD=false

# Merchant identity, as it appears in the ACP product feed at
# /.well-known/product-feed.json. Name only is enough; the URLs become seller
# links in the feed when set.
MERCHANT_NAME=Agent-ready storefront
# MERCHANT_URL=https://example.com
# MERCHANT_PRIVACY_URL=https://example.com/privacy
# MERCHANT_TERMS_URL=https://example.com/terms

# Where the dashboard (apps/web, port 3001) finds the API. Used both for its
# server-side reads and for the /api/* rewrite the browser goes through, which
# is what keeps every dashboard fetch same-origin and CORS out of the API.
API_BASE_URL=http://localhost:3000
