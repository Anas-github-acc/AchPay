# Razorpay test-mode credentials (Phase 5+). Never commit the real .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Any long random string. Signs quotes; rotating it invalidates outstanding quotes.
QUOTE_SIGNING_SECRET=dev_only_change_me_00000000000000000000000000000000

# Ports match docker-compose.yml (deliberately non-default).
DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront
REDIS_URL=redis://localhost:56379

PORT=3000
NODE_ENV=development

# Integration tests run against their own database on the same instance.
TEST_DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront_test
