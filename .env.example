# Razorpay test-mode credentials (Phase 5+). Never commit the real .env.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Any long random string. Signs quotes.
QUOTE_SIGNING_SECRET=dev_only_change_me_00000000000000000000000000000000

# Supabase Postgres connection for the API/server-side migration runner.
DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront
REDIS_URL=redis://localhost:56379
# For Vercel/Upstash, use these instead of REDIS_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TEST_DATABASE_URL=postgres://storefront:storefront@localhost:55432/storefront_test

PORT=3000
NODE_ENV=development
PAYMENT_ADAPTER=fake
RAZORPAY_MANDATE_FREQUENCY=as_presented
RAZORPAY_SBMD=false
APPROVAL_TTL_SECONDS=900

PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
MCP_HTTP_TOKEN=
MERCHANT_NAME=Agent-ready storefront

# Shared permanent demo user. Anonymous sign-ins are not used.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-key
SUPABASE_DEMO_EMAIL=demo@achpay.local
SUPABASE_DEMO_PASSWORD=replace-with-a-long-random-password
SUPABASE_DEMO_USER_ID=fill-after-running-pnpm-demo-provision
DEMO_AUTH_REQUIRED=false

# Secret used by cron-job.org to call GET /internal/reclaim.
CRON_SECRET=replace-with-a-long-random-secret
